{
  "manifest_version": 3,
  "name": "CurseForge Direct Downloads",
  "version": "2.5.0",
  "description": "Downloads CurseForge files through the official API and authenticated ForgeCDN requests.",
  "permissions": [
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.curseforge.com/*",
    "https://api.curseforge.com/*",
    "https://*.forgecdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CurseForge Direct Downloads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.curseforge.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
